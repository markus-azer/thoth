{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/validate-doc-boundary.sh"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "graphify hook-guard search"
					}
				]
			},
			{
				"matcher": "Read|Glob",
				"hooks": [
					{
						"type": "command",
						"command": "graphify hook-guard read"
					}
				]
			}
		]
	}
}
