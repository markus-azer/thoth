{
	"permissions": {
		"allow": [
			"Bash(graphify:*)",
			"Bash(git add:*)",
			"Bash(git commit:*)",
			"Bash(terraform validate:*)",
			"Bash(terraform providers:*)",
			"Bash(terraform plan:*)",
			"mcp__railway__search-docs",
			"mcp__railway__list-services",
			"mcp__railway__list-domains",
			"mcp__railway__get-logs",
			"mcp__railway__list-projects"
		]
	},
	"extraKnownMarketplaces": {
		"ponytail": {
			"source": { "source": "github", "repo": "DietrichGebert/ponytail" }
		},
		"headroom-marketplace": {
			"source": { "source": "github", "repo": "headroomlabs-ai/headroom" }
		}
	},
	"enabledPlugins": {
		"superpowers@claude-plugins-official": true,
		"ponytail@ponytail": true,
		"headroom@headroom-marketplace": true
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/validate-doc-boundary.sh"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "graphify hook-guard search 2>/dev/null || true"
					}
				]
			},
			{
				"matcher": "Read|Glob",
				"hooks": [
					{
						"type": "command",
						"command": "graphify hook-guard read 2>/dev/null || true"
					}
				]
			}
		]
	}
}
