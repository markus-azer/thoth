{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"noEmit": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"plugins": [{ "name": "next" }],
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": ["next-env.d.ts", "src", "test", "dist/types/**/*.ts"]
}
