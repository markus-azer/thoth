{
	"name": "@thoth/core",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"production": "./dist/index.js",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm --sourcemap --clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"arch": "depcruise src"
	},
	"dependencies": {
		"inversify": "8.1.2",
		"uuid": "14.0.1"
	},
	"devDependencies": {
		"dependency-cruiser": "18.1.0",
		"reflect-metadata": "0.2.2",
		"tsup": "8.5.1",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	}
}
