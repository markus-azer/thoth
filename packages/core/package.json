{
	"name": "@thoth/core",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"production": "./dist/index.js",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm --sourcemap --clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"arch": "depcruise src"
	},
	"dependencies": {
		"inversify": "8.2.3",
		"uuid": "14.0.3"
	},
	"devDependencies": {
		"dependency-cruiser": "18.7.0",
		"reflect-metadata": "0.2.2",
		"tsup": "9.0.0",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	}
}
