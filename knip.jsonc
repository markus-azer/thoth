{
	"ignoreDependencies": [
		// referenced by rule id in .secretlintrc.json, not imported
		"@secretlint/secretlint-rule-preset-recommend",
		// provides the railway binary for the db:tunnel script, which knip can't parse through env
		"@railway/cli",
		// peer dependency @promster/metrics imports at runtime for the /metrics endpoint
		"prom-client"
	],
	// system binary invoked by lint-staged for *.tf files, not an npm package
	"ignoreBinaries": ["terraform"],
	"workspaces": {
		"apps/*": {
			"project": "{src,test}/**/*.ts"
		},
		"apps/web": {
			"project": "{src,test}/**/*.{ts,tsx,css}"
		},
		"packages/*": {
			"project": "{src,test}/**/*.ts"
		},
		"packages/ui": {
			"project": "{src,test}/**/*.{ts,tsx,css}"
		}
	}
}
