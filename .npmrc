# versions
# wrong Node blocks install
engine-strict=true
# wrong pnpm blocks install
package-manager-strict=true
# bad peer deps block install
strict-peer-dependencies=true

# lockfile
# no ^/~ ranges
save-exact=true
# CI fails on lockfile drift
prefer-frozen-lockfile=true
# check node_modules matches lockfile
verify-deps-before-run=true

# supply chain
# explicit registry pin
registry=https://registry.npmjs.org/

# hygiene
# ignore low/moderate audit noise
audit-level=high
# silence funding footer
fund=false
